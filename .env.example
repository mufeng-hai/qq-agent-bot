# qq-agent-bot 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 拦截，绝不入库）

# ===== 桥接层运行配置（bridge/qq-bridge.py）=====
# 桥接模式：direct = 直连 NapCat 反向 WebSocket；proxy = 起 OpenAI 兼容 API 服务
BRIDGE_MODE=direct
WS_HOST=0.0.0.0
WS_PORT=6199
NAPCAT_HTTP=http://127.0.0.1:3000
PROXY_PORT=18080

# 模型提供方：opencode（免费，走本地 opencode CLI）/ moonshot / anthropic
LLM_PROVIDER=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free

# ===== API Keys（按所用 provider 选填；真实 key 只放 .env，不入库）=====
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ===== RAG 知识库（rag/ingest.py、rag/retrieve.py）=====
# SiliconFlow 平台 key（https://cloud.siliconflow.cn 注册即送额度，bge embedding 免费）
SILICONFLOW_API_KEY=
# Embedding 模型（免费中文向量大模型）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== 旧版桥接（bridge/qq-opencode-bridge.py 额外用到）=====
NAPCAT_WS=ws://127.0.0.1:3001
ASTROBOT_API_KEY=sk-opencode-bridge

# ===== 可选项 =====
# Windows 下 opencode 可执行文件所在 npm 全局目录（默认值见脚本内）
# NPM_GLOBAL=D:\path\to\npm-global
# 自定义人设（默认人设内置于脚本，可用此变量覆盖）
# SYSTEM_PROMPT=
